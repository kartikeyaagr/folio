{
  "name": "folio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test '**/*.test.ts'",
    "test:watch": "node --test --watch '**/*.test.ts'",
    "test:cov": "node --test --experimental-test-coverage '**/*.test.ts'",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "migrate": "tsx db/migrate.ts",
