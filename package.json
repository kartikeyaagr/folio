    "csv-parse": "^7.0.2",
    "entities": "^8.1.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "next": "^15.5.4",
    "nodemailer": "^10.0.10",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
