[Unit]
# Re-mints the AWS-signed JWT the model client authenticates with. See ops/SETUP.md §10.
Description=Refresh the Anthropic identity token
OnFailure=folio-alert@%n.service

[Service]
Type=oneshot
# Root, not folio: the instance role is reachable either way, but the token is written
# 0640 root:folio so the app can read it and cannot replace it — the same shape as folio.env.
User=root
# The directory survives the unit exiting. Without this systemd removes /run/folio the moment
# this oneshot finishes, taking the token with it.
RuntimeDirectory=folio
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/srv/folio/ops/refresh-identity-token.sh /run/folio/identity-token

Environment=AWS_REGION=ap-south-1
Environment=TZ=Asia/Kolkata

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
StandardOutput=journal
StandardError=journal
