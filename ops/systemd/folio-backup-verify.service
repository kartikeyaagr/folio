[Unit]
# An untested restore is not a backup. This runs the whole round trip against a throwaway key:
# dump, encrypt, decrypt, restore into a fresh database, compare row counts table by table.
Description=Folio restore drill
After=postgresql.service
OnFailure=folio-alert@%n.service

[Service]
Type=oneshot
User=folio
EnvironmentFile=/etc/folio/folio.env
Environment=TZ=Asia/Kolkata
ExecStart=/srv/folio/ops/verify-backup.sh folio
NoNewPrivileges=yes
ProtectHome=yes
