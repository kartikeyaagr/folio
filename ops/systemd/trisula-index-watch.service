[Unit]
# Indexes within seconds of a save, instead of within ten minutes of one.
#
# This does NOT replace trisula-index-content.timer, and enabling it is not a reason to disable
# that. The timer is what guarantees the queue drains; this only makes the common case fast. A
# NOTIFY sent while this unit was restarting is gone and nothing replays it — the durable queue is
# `sources.indexed_at IS NULL`, which the timer sweeps regardless of what was heard.
#
# Long-running, so this is a `simple` service and not an instance of trisula-job@.service: that
# template is Type=oneshot with a 30-minute TimeoutStartSec, which would kill this on the half hour.
Description=Index content as it is saved
After=postgresql.service
# Not OnFailure=trisula-alert@%n.service. This restarts on its own and the timer covers what it
# misses, so a transient database blip here is not something to wake anybody for. A watcher that is
# genuinely dead shows up as indexing lag on /admin, which is the figure that already means this.

# In [Unit], not [Service]: systemd moved these in v229 and ignores them in the old place without
# complaining. They sat in [Service] until 21-Sep-2026, so the property their comment below claims
# — that a crash loop eventually reaches `failed` rather than restarting every ten seconds forever
# — has never actually held here. This unit raises no alert by choice, but `failed` is still what
# `systemctl status` shows and what tells a dying watcher from a working one.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=trisula
WorkingDirectory=/srv/trisula
EnvironmentFile=/etc/trisula/trisula.env
ExecStart=/usr/bin/pnpm exec tsx jobs/index-content.ts --watch

Restart=always
RestartSec=10
# The rate limit that makes a crash loop end in `failed` rather than restarting every 10s forever
# is StartLimitIntervalSec/StartLimitBurst, in [Unit] at the top of this file. Without it nothing
# downstream can tell a working watcher from one that has been dying all night.

# It loads the 130MB ONNX embedder and holds it for the life of the process — that is the point of
# staying up, and the same argument jobs/index-content.ts makes for doing both queues in one run.
MemoryMax=2G

Environment=PGHOST=/var/run/postgresql
Environment=TZ=Asia/Kolkata

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trisula

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
