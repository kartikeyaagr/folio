[Unit]
Description=Insider and pledge disclosures

[Timer]
# After the market closes. PIT disclosures are filed within two trading days of the trade, so
# nothing here is time-critical to the minute.
OnCalendar=*-*-* 19:30 Asia/Kolkata
Persistent=true
Unit=folio-job@ingest-insider.service

[Install]
WantedBy=timers.target
