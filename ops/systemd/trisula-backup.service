[Unit]
Description=Trisula nightly encrypted backup
After=postgresql.service
OnFailure=trisula-alert@%n.service

[Service]
Type=oneshot
User=trisula
EnvironmentFile=/etc/trisula/trisula.env
Environment=TZ=Asia/Kolkata
ExecStart=/srv/trisula/ops/backup.sh trisula
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/trisula/backups
