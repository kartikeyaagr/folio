[Unit]
Description=News feeds, and the net

[Timer]
# Every two hours through the working day. The feeds carry 10-200 items each and turn over slowly;
# polling faster would re-read the same headlines and store nothing.
# `07..21` is a range and `07/2` is a range with a step; the first spelling ran this every hour,
# twice as often as the paragraph above argues for and says it does.
OnCalendar=*-*-* 07/2:05:00 Asia/Kolkata
Persistent=true
Unit=trisula-job@news-poll.service

[Install]
WantedBy=timers.target
