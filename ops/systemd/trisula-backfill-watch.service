[Unit]
# Fills a name in the moment somebody clicks Follow.
#
# `trisula-backfill-company.timer` is still the drainer and is still what guarantees the work
# happens: a NOTIFY with nobody listening is discarded, and this unit being down is exactly the
# state where that matters. This removes the wait, it does not replace the queue — which is why
# both are enabled and why the watcher drains the whole queue on every wake rather than trusting
# the symbol in the payload.
#
# Not a `trisula-job@` instance: that template is Type=oneshot with a 30-minute TimeoutStartSec,
# and this process is meant to stay up.
Description=Trisula backfill watcher
After=postgresql.service
OnFailure=trisula-alert@%n.service

[Service]
Type=simple
User=trisula
WorkingDirectory=/srv/trisula
EnvironmentFile=/etc/trisula/trisula.env
ExecStart=/usr/bin/pnpm exec tsx jobs/backfill-company.ts --watch

# A watcher that exits on a bad NSE ten minutes is a watcher that is down when the next name is
# followed. `lib/db.ts:listen` already reconnects through a Postgres restart on its own; this is
# for everything it cannot catch.
Restart=always
RestartSec=10
# Without these, RestartSec=10 can never exceed systemd's default burst limit, so the unit never
# reaches `failed` and OnFailure= above never fires — the trap §2.6 of the readiness audit found
# on trisula-web.service.
StartLimitIntervalSec=300
StartLimitBurst=10

# Postgres over a unix socket, so it needs no TCP listener.
Environment=PGHOST=/var/run/postgresql
# Every job time in this system is IST, and the dates it computes are Indian trading dates.
Environment=TZ=Asia/Kolkata

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trisula

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
