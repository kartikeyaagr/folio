[Unit]
Description=Folio nightly encrypted backup
After=postgresql.service
OnFailure=folio-alert@%n.service

[Service]
Type=oneshot
User=folio
EnvironmentFile=/etc/folio/folio.env
Environment=TZ=Asia/Kolkata
ExecStart=/srv/folio/ops/backup.sh folio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/folio/backups
