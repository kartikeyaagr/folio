[Unit]
Description=Bonuses, splits and dividends for followed names

[Timer]
# Once a day, before the market opens, alongside the calendar. An action is announced days ahead of
# its ex-date, so nothing here is time-critical — but it must land before the ex-date, not after,
# which is why the window looks forward a quarter as well as back a month.
OnCalendar=*-*-* 07:50 Asia/Kolkata
Persistent=true
Unit=folio-job@ingest-corporate-actions.service

[Install]
WantedBy=timers.target
