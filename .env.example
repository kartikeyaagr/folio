# Every variable this system reads, in one place.
#
# Until 23-Sep-2026 the only copy of this contract was a heredoc inside ops/SETUP.md §6, and it had
# already drifted: APP_URL, MAILBOX_KEY, EMBED_MODEL_DIR and ATTACHMENT_DIR are all read by code and
# none of them appeared in it. A list that lives beside the code it describes is a list that gets
# updated when the code does.
#
#   development   cp .env.example .env.local, then fill in DATABASE_URL and ANTHROPIC_API_KEY
#   production    ops/SETUP.md §6 is still the authority — it explains WHY each of these is what it
#                 is, and the VM reads /etc/trisula/trisula.env, never this file
#
# `pnpm preflight` checks the ones that can be checked.

# ---- Required -------------------------------------------------------------------------------

# Empty host, so pg uses the unix socket. See ops/SETUP.md §4.
DATABASE_URL=postgres:///trisula_v3_dev

# Where this instance is reached. app/logout/route.ts redirects here after sign-out and falls back
# to http://localhost:3100 when unset — right on a laptop, a dead tab on the VM.
APP_URL=http://localhost:3100

# Every date this system computes is an Indian trading date.
TZ=Asia/Kolkata

# ---- The model credential -------------------------------------------------------------------
# lib/agents/client.ts picks a backend by which of these is PRESENT: federation first, then the AWS
# workspace, then ANTHROPIC_API_KEY. With none of them it throws NoModelCredentials naming what is
# missing. See ops/SETUP.md §10.

ANTHROPIC_API_KEY=

# Workload identity federation — the production upgrade, no secret on disk. Setting the rule id is
# what switches the backend. Leave COMMENTED rather than blank: unlike ANTHROPIC_API_KEY these are
# read straight into the SDK's config, where an empty string occupies the slot and fails as a 401
# instead of falling through.
#ANTHROPIC_FEDERATION_RULE_ID=
#ANTHROPIC_ORGANIZATION_ID=
#ANTHROPIC_SERVICE_ACCOUNT_ID=
#ANTHROPIC_IDENTITY_TOKEN_FILE=/run/trisula/identity-token
#ANTHROPIC_WORKSPACE_ID=

# Claude Platform on AWS — the second backend chosenBackend() knows, and unreachable on this account
# (it bills through AWS Marketplace, which a Sign up for AWS (new) account cannot use). Listed so
# this file is the whole contract; a workspace id found set on the box is stale, not intended.
#ANTHROPIC_AWS_WORKSPACE_ID=
#AWS_REGION=

# ---- Paths ------------------------------------------------------------------------------------

# Filed PDFs and imported files. Defaults to /var/lib/trisula/attachments, which is in the web
# unit's ReadWritePaths= — a path outside it fails EROFS under ProtectSystem=strict. On a laptop that
# path does not exist: set it (e.g. $HOME/.trisula/attachments) or leave it commented.
#ATTACHMENT_DIR=

# The 130 MB bge-small-en-v1.5 ONNX model. Unset, lib/retrieval/embed.ts looks in
# /var/lib/trisula/models/bge-small-en-v1.5 then <repo>/.models/bge-small-en-v1.5, which is where
# `pnpm fetch-model` writes. Set it only to point somewhere else; it does NOT fall back.
EMBED_MODEL_DIR=

# ---- Mail -------------------------------------------------------------------------------------
# No relay is a valid state: lib/notify.ts returns null, the outbox queues, nothing fails — and
# nothing leaves the box either. SMTP_HOST and SMTP_FROM are needed together; one alone reads as
# configured and sends nothing.

SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Seals a person's own mailbox password, AES-256-GCM. 32 bytes base64: openssl rand -base64 32.
# Without it, linking refuses outright — there is no plaintext path. Not in a database backup.
MAILBOX_KEY=

# ---- Monitoring and backups (the VM; shell scripts read these, not the app) --------------------

# The dead man's switch. jobs/heartbeat.ts POSTs here every 15 minutes and ONLY when Postgres
# answers, so the alarm is the monitor noticing silence. Unset, nothing would notice a dead box.
HEARTBEAT_URL=

# The age PUBLIC key. The private half never touches the server — that is the whole design.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/lib/trisula/backups
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# ---- Only behind a reverse proxy that rewrites x-forwarded-for --------------------------------
# Next sets the header with ??=, so with no proxy the value is whatever the client typed — and a
# rate-limit key the caller chooses lets them evade the limit AND lock somebody else out of /login.
# Under Tailscale, leave unset.
TRUST_PROXY_HEADER=
